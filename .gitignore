# Connect IQ build output
bin/
*.prg
*.iq
gen/
*-mir/
*.mir
*.mcgen
*.mbc

# Developer keys / secrets (never commit these)
developer_key*
*.der
*.pem

# Editor / IDE
*-settings.json
.vscode/

# Temp
*.tmp

# Python bytecode. scripts/cue_replay.py is the first script here that another
# script IMPORTS rather than shells out to, so a scripts/__pycache__/ appears
# the moment scripts/test_cue_replay.py runs.
__pycache__/
*.pyc

# Agent worktrees live under .claude/worktrees/ (540 MB, ~28 nested worktrees).
# The settings file IS versioned; the worktrees are not. An accidental `git add -f`
# here is also what makes monkeyc walk every worktree copy of source/ and fail with
# "Redefinition of $.StrongRowView" -- see the release ritual.
.claude/worktrees/
