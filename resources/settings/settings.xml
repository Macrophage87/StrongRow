<settings>
    <setting propertyKey="@Properties.workoutEnabled" title="@Strings.setWorkoutEnabled">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.numIntervals" title="@Strings.setNumIntervals">
        <settingConfig type="numeric" min="1" max="30"/>
    </setting>
    <setting propertyKey="@Properties.workMinutes" title="@Strings.setWorkMinutes">
        <settingConfig type="numeric" min="0.5" max="60"/>
    </setting>
    <setting propertyKey="@Properties.restMinutes" title="@Strings.setRestMinutes">
        <settingConfig type="numeric" min="0" max="60"/>
    </setting>
    <setting propertyKey="@Properties.targetLo" title="@Strings.setTargetLo">
        <settingConfig type="numeric" min="4" max="60"/>
    </setting>
    <setting propertyKey="@Properties.targetHi" title="@Strings.setTargetHi">
        <settingConfig type="numeric" min="4" max="60"/>
    </setting>
    <setting propertyKey="@Properties.hrLo" title="@Strings.setHrLo">
        <settingConfig type="numeric" min="80" max="190"/>
    </setting>
    <setting propertyKey="@Properties.hrHi" title="@Strings.setHrHi">
        <settingConfig type="numeric" min="80" max="190"/>
    </setting>
    <setting propertyKey="@Properties.pressToContinue" title="@Strings.setPressToContinue">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.dpsBenchmark" title="@Strings.setDpsBenchmark">
        <settingConfig type="numeric" min="1" max="20"/>
    </setting>
    <setting propertyKey="@Properties.warmupCooldown" title="@Strings.setWarmupCooldown">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.ergMode" title="@Strings.setErgMode">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.ergPowerUnits" title="@Strings.setErgPowerUnits">
        <settingConfig type="boolean"/>
    </setting>
    <!-- The declared range is ALSO enforced in loadSettings. #21 is precisely
         the defect of a range declared here and nowhere else: this bound binds
         the Garmin Connect UI and nothing more, while Connect IQ Properties
         survive an app update and a sideloaded .set file is not re-clamped on
         load. -->
    <setting propertyKey="@Properties.jouleBenchmark" title="@Strings.setJouleBenchmark">
        <settingConfig type="numeric" min="50" max="2000"/>
    </setting>
</settings>
